
enable
configure terminal
hostname YAOUNDE
no ip domain lookup
line console 0
 exec-timeout 0 0
 logging synchronous
 exit

int e2/1
 ip address 20.20.37.3 255.255.255.240
 description YAOUNDE -----> BAMENDA
 no shutdown
 exit
int e2/2
 ip address 20.20.36.3 255.255.255.240
 description YAOUNDE -----> BUEA
 no shutdown
 exit
int e2/3
 ip address 20.20.31.3 255.255.255.240
 description YAOUNDE -----> MAROUA
 no shutdown
 exit
int e3/1
 ip address 20.20.34.3 255.255.255.240
 description YAOUNDE -----> GAROUA
 no shutdown
 exit
int e3/2
 ip address 20.20.38.3 255.255.255.240
 description YAOUNDE -----> NGAOUNDERE
 no shutdown
 exit
int e3/3
 ip address 20.20.39.3 255.255.255.240
 description YAOUNDE -----> BAFOUSSAM
 no shutdown
 exit
int lo0
 ip address 12.12.12.12 255.255.255.255
 no shutdown
 exit

router ospf 3
 network 20.20.31.0 0.0.0.15 area 0
 network 20.20.34.0 0.0.0.15 area 0
 network 20.20.38.0 0.0.0.15 area 0
 network 20.20.39.0 0.0.0.15 area 0
 network 20.20.36.0 0.0.0.15 area 0
 network 20.20.37.0 0.0.0.15 area 0
 network 12.12.12.12 0.0.0.0 area 0
 exit

ip cef
mpls label range 800 899
mpls label protocol ldp
mpls ldp router-id loopback0

interface e2/1
 mpls ip
 exit
interface e2/2
 mpls ip
 exit
interface e2/3
 mpls ip
 exit
interface e3/1
 mpls ip
 exit
interface e3/2
 mpls ip
 exit
interface e3/3
 mpls ip
 exit
