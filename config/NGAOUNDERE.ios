
enable
configure terminal
hostname NGAOUNDERE
no ip domain lookup
line console 0
 exec-timeout 0 0
 logging synchronous
 exit

int e0/1
 ip address 4.4.4.8 255.255.255.240
 description NGAOUNDERE -----> GAROUA
 no shutdown
 exit
int e1/2
 ip address 20.20.38.8 255.255.255.240
 description NGAOUNDERE -----> YAOUNDE
 no shutdown
 exit
int e0/2
 ip address 10.100.100.8 255.255.255.240
 description NGAOUNDERE -----> BAFOUSSAM
 no shutdown
 exit
int lo0
 ip address 77.77.77.77 255.255.255.255
 no shutdown
 exit

router ospf 8
 network 4.4.4.0 0.0.0.15 area 0
 network 20.20.38.0 0.0.0.15 area 0
 network 10.100.100.0 0.0.0.15 area 0
 network 77.77.77.77 0.0.0.0 area 0
 exit

ip cef
mpls label range 700 799
mpls label protocol ldp
mpls ldp router-id loopback0

interface e0/1
 mpls ip
 exit
interface e0/2
 mpls ip
 exit
interface e1/2
 mpls ip
 exit


ip vrf GI
 rd 65005:300
 route-target import 65005:300
 route-target export 65005:300
 exit


int e4/0
 ip vrf forwarding GI
 ip address 192.168.14.1 255.255.255.240
 exit

do wr
